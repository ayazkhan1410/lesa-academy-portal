# Local development (Docker Compose)
# Copy to `.env` and adjust values.

# Database
DB_NAME=lesa_db
DB_USER=admin
DB_PASSWORD=Strong123
DB_HOST=db
DB_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# SMS gateway (must be reachable from your server in production)
MOBILE_GATEWAY_URL=http://192.168.1.2:8080/send-sms

# Django
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,the-learning-and-educational-science.onrender.com
CORS_ALLOWED_ORIGINS=https://the-learning-and-educational-science.onrender.com

# Render production uses DATABASE_URL instead of DB_* vars.
# DATABASE_URL=postgres://...

# Superuser auto-creation on startup (set these on Render, not locally)
# DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=YourStrongPassword123!
